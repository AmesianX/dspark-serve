+def _check_kpool_chunk_alignment(vllm_config: VllmConfig, kpool: int) -> None:
+    """Refuse configurations whose prefill chunks can start mid-pool.
+
+    LANE PATCH (2026-09-28). The prefill insert (_kpool_compress_insert)
+    completes a pool only from tokens inside the current chunk and never reads
+    the tail cache, so a chunk that starts mid-pool drops the straddling pool
+    (stale bytes stay in its slot) or, for a later request in the batch, pools
+    K across the request boundary. Both stay in the top-k candidate set for
+    the rest of the request. Nothing enforces the alignment directly; it holds
+    only through the scheduler's mamba "align" split, which floors every
+    non-final prefill chunk to the block grid. That split has sub-block escape
+    hatches, so reject each one here instead of corrupting silently.
+    """
+    cache = vllm_config.cache_config
+    sched = vllm_config.scheduler_config
+    if not sched.enable_chunked_prefill:
+        return
+    problems = []
+    if cache.mamba_cache_mode != "align":
+        problems.append(
+            f"mamba_cache_mode={cache.mamba_cache_mode!r} (needs 'align', which "
+            "is the default only with prefix caching enabled)"
+        )
+    # Mirrors Scheduler._mamba_block_aligned_split: a chunk is floored to the
+    # block grid unless the effective chunk limit is below the block size.
+    # Only a positive mixed-prefill cap limits chunks (-1 skips, 0 is off).
+    limit = sched.max_num_batched_tokens
+    if sched.long_prefill_token_threshold > 0:
+        limit = min(limit, sched.long_prefill_token_threshold)
+    if sched.mixed_prefill_token_cap > 0:
+        limit = min(limit, sched.mixed_prefill_token_cap)
+    # The split floors to the Mamba block grid; take the wider of the two
+    # sizes the config knows about (block_size is already raised to the
+    # attention/Mamba page-matched size by the time KV specs are built).
+    grid = max(cache.block_size, getattr(cache, "mamba_block_size", None) or 0)
+    if limit < grid:
+        problems.append(
+            f"prefill chunk limit {limit} < block grid {grid} "
+            "(blocks wider than a chunk advance sub-block)"
+        )
+    for name, val in (
+        ("block_size", cache.block_size),
+        ("mamba_block_size", getattr(cache, "mamba_block_size", None)),
+        ("prefix_match_unit", cache.prefix_match_unit),
+    ):
+        if val is not None and val % kpool:
+            problems.append(f"{name}={val} is not a multiple of index_kpool={kpool}")
+    if problems:
+        raise ValueError(
+            "Glm5Next kpool indexer: prefill chunks are not guaranteed to "
+            "start on a pool boundary: " + "; ".join(problems)
+        )
+
