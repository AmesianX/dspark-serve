+    def _scheduled_batch_has_prefill(self, scheduler_output: SchedulerOutput) -> bool:
+        """Whether any scheduled request is still prefilling (vllm#51865)."""
+        req_id_to_index = self.req_states.req_id_to_index
+        prefill_len = self.req_states.prefill_len.np
+        computed = self.req_states.num_computed_prefill_tokens
+        for req_id in scheduler_output.num_scheduled_tokens:
+            idx = req_id_to_index[req_id]
+            if computed[idx] < prefill_len[idx]:
+                return True
+        return False
