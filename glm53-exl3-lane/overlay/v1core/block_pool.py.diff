+# LANE PATCH (2026-11-27): KV identity is (tokens, /ab scale). See ab_switch.py,
+# the block above ``_scale_vec``. Blocks computed at a non-default scale are
+# keyed with ab_switch.tag_hash(chain_hash, ns); lookups for such a request try
+# its namespace first, then the default one. Default requests never see tags.
+try:
+    import ab_switch as _ab_switch
+except Exception:  # pragma: no cover - lane without the /ab overlay
+    _ab_switch = None
+
+
+def _request_namespace(request: Request) -> str | None:
+    if _ab_switch is None:
+        return None
+    sampling_params = getattr(request, "sampling_params", None)
+    if sampling_params is None:
+        return None
+    return _ab_switch.cache_namespace(sampling_params)
+
+
+def _keyed(block_hash: BlockHash, ns: str | None) -> BlockHash:
+    if ns is None:
+        return block_hash
+    return BlockHash(_ab_switch.tag_hash(block_hash, ns))
+
