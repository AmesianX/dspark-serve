+def _png_exif_chunk(data: bytes) -> bytes:
+    """PNG 청크를 디코드 없이 훑어 eXIf 를 Pillow chunk_eXIf 형식으로. 없으면 b""."""
+    i, n = 8, len(data)
+    while i + 8 <= n:
+        length = int.from_bytes(data[i : i + 4], "big")
+        cid = data[i + 4 : i + 8]
+        if cid == b"eXIf":
+            return b"Exif\x00\x00" + data[i + 8 : i + 8 + length]
+        if cid == b"IEND":
+            break
+        i += 12 + length
+    return b""
+
