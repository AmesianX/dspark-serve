+def finish_lazy_image(image: Image.Image) -> Image.Image:
+    """지연 로드된 이미지와 같은 바이트로 새 객체를 열어 업스트림 load_bytes 와 같은
+    정규화·디코드·모드 변환을 한다. 지연 표식이 없으면(이미 디코드된 이미지) 그대로 돌려준다."""
+    mark = getattr(image, "_glm53_lazy", None)
+    if mark is None:
+        return image
+    image_mode, rgba_bg, data = mark
+    image = normalize_image(Image.open(BytesIO(data)))  # 새 객체. 호출자는 다 쓰고 닫는다.
+    image.load()
+    if image_mode is None or image.mode == image_mode:
+        return image
+    if image.mode == "RGBA" and image_mode == "RGB":
+        return rgba_to_rgb(image, rgba_bg)
+    return convert_image_mode(image, image_mode, rgba_bg)
+
