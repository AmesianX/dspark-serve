+def _build_subset_draft_head(layer, ids_path: str, group_size: int = 128, prefix: str = "") -> None:
+    import json as _json
+    from vllm.model_executor.layers.quantization.utils.marlin_utils_fp8 import marlin_quant_fp8_torch
+    w = layer.weight.data                      # 이 랭크 BF16 조각 [n_local_padded, k]
+    n_local, k = w.shape
+    si = layer.shard_indices
+    start, end = int(si.org_vocab_start_index), int(si.org_vocab_end_index)
+    ids = torch.tensor(sorted(set(_json.load(open(ids_path)))), dtype=torch.long)
+    ids = ids[(ids >= start) & (ids < end)] - start
+    n_rows = int(ids.numel())
+    n_pad = (n_rows + 255) // 256 * 256        # Marlin 타일 정렬, 패딩 행 출력은 결과에서 잘라냄
+    with torch.no_grad():
+        # 패딩 행은 실제 첫 행 복사: 0 행이면 FP8 스케일 0 → 0/0=NaN 열(잘라내긴 하지만 취약)
+        sub_w = w[ids.to(w.device)][[0]].repeat(n_pad, 1)
+        sub_w[:n_rows] = w[ids.to(w.device)]
+        _ref, q_w, s = marlin_quant_fp8_torch(sub_w, group_size)
+        rel = ((_ref.T[:n_rows].float() - sub_w[:n_rows].float()).norm() / sub_w[:n_rows].float().norm()).item()
+        del _ref, sub_w
+    layer.subset_draft_head = _SubsetDraftHead(q_w, s, ids.to(w.device), n_rows, n_pad, k, n_local, w.device)
+    logger.info_once(
+        "[ours] subset draft lm_head on %s: %d/%d rows of this shard (FP8 W8A16 g%d, rel-err %.4f), vocab file %s",
+        prefix, n_rows, n_local, group_size, rel, ids_path,
+    )
+
+
+def _build_int4_draft_head(layer, group_size: int = 128) -> None:
+    from vllm.model_executor.layers.quantization.utils.marlin_utils_test import marlin_quantize
+    from vllm.scalar_type import scalar_types
+    w = layer.weight.data
+    n, k = w.shape
+    with torch.no_grad():
+        w_ref, q_w, s, _g, _si, _rp = marlin_quantize(
+            w.t().contiguous(), scalar_types.uint4b8, group_size, act_order=False
+        )
+        rel = ((w_ref.t().float() - w.float()).norm() / w.float().norm()).item()
+        del w_ref
+    layer.int4_draft_head = _Int4DraftHead(q_w, s, n, k, w.device)
+    logger.info_once(
+        "[ours] INT4 draft lm_head built: shard %dx%d g%d rel-err %.4f (MTP draft top-k only; verify head untouched)",
+        n, k, group_size, rel,
+    )
+
