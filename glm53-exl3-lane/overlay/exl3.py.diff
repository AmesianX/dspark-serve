+# [ours] 2026-09-03 프리필 BF16 이중경로: Marlin W8A16 은 큰 M(프리필)에서 cuBLAS BF16 보다 느리다(12k 프리필 -12%).
+#  M > VLLM_EXL3_PREFILL_BF16_MIN_M 이면 Marlin 패킹 FP8 을 역변환·dequant 해 BF16 cuBLAS 로, 작은 M(디코드)은 Marlin 그대로.
+#  역변환 근거: marlin_utils_test.marlin_weights(16x16 타일 재배열 → 1024단위 perm → 4바이트 팩)의 정확한 역, 스케일은
+#  get_scale_perms 의 64단위 역순열 + fp8_fused_exponent_bias(bf16=2^120) 제거. 상주 메모리 0(호출 때마다 풀고 버림).
+_MARLIN_UNPACK_CACHE: dict = {}
+
+
+def _marlin_fp8_inv_perms(device):
+    key = str(device)
+    if key not in _MARLIN_UNPACK_CACHE:
+        from vllm.model_executor.layers.quantization.utils.marlin_utils import get_scale_perms
+        from vllm.model_executor.layers.quantization.utils.marlin_utils_test import get_weight_perm
+        perm = get_weight_perm(8).to(torch.long)
+        inv_w = torch.empty_like(perm)
+        inv_w[perm] = torch.arange(perm.numel(), dtype=torch.long)
+        scale_perm, _ = get_scale_perms()
+        sp = torch.tensor(scale_perm, dtype=torch.long)
+        inv_s = torch.empty_like(sp)
+        inv_s[sp] = torch.arange(sp.numel(), dtype=torch.long)
+        _MARLIN_UNPACK_CACHE[key] = (inv_w.to(device), inv_s.to(device))
+    return _MARLIN_UNPACK_CACHE[key]
+
+
+def marlin_fp8_unpack(packed: torch.Tensor, padded_k: int, padded_n: int) -> torch.Tensor:
+    """gptq_marlin_repack(num_bits=8) 출력 [K/16, N*16/4] int32 → fp8 [K, N] (패딩 포함)."""
+    inv_w, _ = _marlin_fp8_inv_perms(packed.device)
+    kt = padded_k // 16
+    b = packed.contiguous().view(torch.uint8)            # [kt, N*16]: int32 j 의 byte i = 원소 4j+i
+    b = b.view(kt, -1, inv_w.numel())[:, :, inv_w]        # perm 역: src[q] = out[inv[q]]
+    b = b.reshape(kt, padded_n // 16, 16, 16)             # (n_tile, kk, nn)
+    b = b.permute(0, 2, 1, 3).reshape(padded_k, padded_n)  # (kt, kk) → K, (n_tile, nn) → N
+    return b.view(torch.float8_e4m3fn)
+
+
+def marlin_fp8_scales_unpermute(marlin_scales: torch.Tensor, padded_n: int, exp_bias: float) -> torch.Tensor:
+    """marlin_permute_scales(group 128) + exponent bias 의 역 → [K/128, N] (패딩 포함)."""
+    _, inv_s = _marlin_fp8_inv_perms(marlin_scales.device)
+    s = marlin_scales.to(torch.float32) / exp_bias
+    return s.reshape(-1, inv_s.numel())[:, inv_s].reshape(-1, padded_n)
+
+
+_TRITON_UNPACK = None
+
+
+def _get_triton_unpack():
+    global _TRITON_UNPACK
+    if _TRITON_UNPACK is None:
+        import triton
+        import triton.language as tl
+
+        @triton.jit
+        def _marlin_unpack_dequant_kernel(
+            packed_ptr, inv_ptr, scale_ptr, out_ptr, N, K, PN, stride_sk,
+            BLOCK_GROUP: tl.constexpr,
+        ):
+            # 프로그램 = 패킹 행 kt 의 1024바이트 청크 g = 출력 타일 k∈[kt*16,+16), n∈[g*64,+64)
+            kt = tl.program_id(0)
+            g = tl.program_id(1)
+            q = tl.arange(0, 1024)
+            inv = tl.load(inv_ptr + q)                                   # src[q] = out[inv[q]]
+            base = packed_ptr + kt * (PN * 16) + g * 1024
+            b = tl.load(base + inv)                                      # uint8, 1KB 창 안 gather
+            w = b.to(tl.float8e4nv, bitcast=True).to(tl.float32)
+            # q → (n_tile=q//256, kk=(q%256)//16, nn=q%16)
+            n = g * 64 + (q // 256) * 16 + (q % 16)
+            k = kt * 16 + (q % 256) // 16
+            sc = tl.load(scale_ptr + (k // BLOCK_GROUP) * stride_sk + n, mask=n < N, other=0.0)
+            val = (w * sc).to(out_ptr.dtype.element_ty)
+            tl.store(out_ptr + n.to(tl.int64) * K + k, val, mask=(n < N) & (k < K))
+
+        _TRITON_UNPACK = _marlin_unpack_dequant_kernel
+    return _TRITON_UNPACK
+
+
+def marlin_fp8_dequant_bf16_triton(layer) -> torch.Tensor:
+    """Triton 한 패스: Marlin 패킹 FP8 → BF16 [N, K]. 스케일은 [K/128, PN] 역순열본을 층에 캐시(수 MB)."""
+    from vllm.model_executor.layers.quantization.utils.marlin_utils import marlin_repacked_nk
+    n, k = layer._prefill_nk
+    padded_n, padded_k = marlin_repacked_nk(layer.weight, 8)
+    sc = getattr(layer, "_prefill_scales_kn", None)
+    if sc is None:
+        scales = getattr(layer, "weight_scale_inv", None)
+        if scales is None:
+            scales = layer.weight_scale
+        exp_bias = 2.0 ** 120 if layer.orig_dtype == torch.bfloat16 else 2.0 ** 8
+        sc = marlin_fp8_scales_unpermute(scales, padded_n, exp_bias).contiguous()   # [K/128, PN] fp32
+        layer._prefill_scales_kn = sc
+    inv_w, _ = _marlin_fp8_inv_perms(layer.weight.device)
+    out = torch.empty((n, k), dtype=layer.orig_dtype, device=layer.weight.device)
+    kern = _get_triton_unpack()
+    kern[(padded_k // 16, padded_n // 64)](
+        layer.weight.view(torch.uint8), inv_w.to(torch.int32), sc, out, n, k, padded_n, sc.stride(0),
+        BLOCK_GROUP=128, num_warps=4,
+    )
+    return out
+
+
+def marlin_fp8_dequant_bf16(layer) -> torch.Tensor:
+    """Marlin 패킹 FP8 블록 가중치 → BF16 [N, K] (layer 의 nn.Linear 레이아웃). torch 참조 구현."""
+    from vllm.model_executor.layers.quantization.utils.marlin_utils import marlin_repacked_nk
+    n, k = layer._prefill_nk
+    padded_n, padded_k = marlin_repacked_nk(layer.weight, 8)
+    w = marlin_fp8_unpack(layer.weight, padded_k, padded_n)[:k, :n].t()          # [N, K] fp8
+    scales = getattr(layer, "weight_scale_inv", None)
+    if scales is None:
+        scales = layer.weight_scale
+    exp_bias = 2.0 ** 120 if layer.orig_dtype == torch.bfloat16 else 2.0 ** 8
+    s = marlin_fp8_scales_unpermute(scales, padded_n, exp_bias)[:, :n].t()        # [N, K/128] fp32
+    kg = s.shape[1]
+    out = w.to(torch.float32).reshape(n, kg, k // kg) * s.reshape(n, kg, 1)
+    return out.reshape(n, k).to(layer.orig_dtype)
+
+# [ours] 2026-09-03 MTP 드래프트 전용 INT4(Marlin W4A16, g128) lm_head 복사본.
+#  MTP-4 는 스텝마다 lm_head 를 5회 읽고(드래프트 4 + verify 1, 각 1.46ms/노드) 8.7% 를 쓴다.
+#  드래프트의 greedy top-k 만 INT4 복사본으로 계산하고 verify 는 FP8 헤드 그대로 → 출력분포 무손실.
+#  포크의 DFlash "rowwise-fp8 draft head" 와 같은 설계. 빌드 시점 = BF16→FP8 패킹 직전(여기).
+class _Int4DraftHead:
+    def __init__(self, qweight, scales, n_local, k, device):
+        from vllm.model_executor.layers.quantization.utils.marlin_utils import (
+            marlin_make_empty_g_idx, marlin_make_workspace_new,
+        )
+        from vllm.scalar_type import scalar_types
+        self.qweight = qweight
+        self.scales = scales
+        self.n_local = int(n_local)
+        self.k = int(k)
+        self.g_idx = marlin_make_empty_g_idx(device)
+        self.g_idx_sort = marlin_make_empty_g_idx(device)
+        self.zp = marlin_make_empty_g_idx(device)
+        self.workspace = marlin_make_workspace_new(device)
+        self.wtype = scalar_types.uint4b8
+
+    def apply(self, layer, x, bias=None):
+        from vllm.model_executor.layers.quantization.utils.marlin_utils import (
+            apply_gptq_marlin_linear,
+        )
+        return apply_gptq_marlin_linear(
+            x, self.qweight, self.scales, self.zp, self.g_idx, self.g_idx_sort,
+            self.workspace, self.wtype, self.n_local, self.k, is_k_full=True, bias=bias,
+        )
+
+
+class _SubsetDraftHead:
+    """[ours] MTP 드래프트 greedy argmax 전용 축소 어휘 lm_head (FP8 W8A16 Marlin, 그룹 128 스케일).
+
+    verify(본 모델 compute_logits)는 전체 어휘 FP8 헤드 그대로 → 출력 분포 무손실. 드래프트는 이 랭크
+    어휘 조각 중 축소 어휘에 속한 행만 계산하고, 나머지 자리는 -inf 로 채워 기존 vocab-parallel
+    로짓 gather 경로를 그대로 탄다(V2 드래프트 = MTP compute_logits + argmax; get_top_tokens 도 동일 프록시).
+    축소 어휘 밖 토큰은 드래프트가 못 낼 뿐, verify 가 거부하고 목표 모델 토큰으로 바꾼다.
+    """
+
+    def __init__(self, qweight, scales, local_idx, n_rows, n_pad, k, full_n, device):
+        from vllm.model_executor.layers.quantization.utils.marlin_utils import marlin_make_workspace_new
+        self.qweight = qweight
+        self.scales = scales
+        self.local_idx = local_idx          # [n_rows] int64, 이 랭크 조각 안 열 번호
+        self.n_rows = int(n_rows)           # 실제 축소 어휘 행 수
+        self.n_pad = int(n_pad)             # Marlin 타일 맞춤 패딩 포함 행 수
+        self.k = int(k)
+        self.full_n = int(full_n)           # 이 랭크 조각 전체 행 수(출력 폭). apply 의 layer 는 프록시라 여기 둔다
+        self.workspace = marlin_make_workspace_new(device)
+
+    def apply(self, layer, x, bias=None):
+        from vllm.model_executor.layers.quantization.utils.marlin_utils_fp8 import apply_fp8_marlin_linear
+        compact = apply_fp8_marlin_linear(
+            x, self.qweight, self.scales, self.workspace, self.n_pad, self.k, None
+        )[..., : self.n_rows]
+        out = torch.full(
+            (*compact.shape[:-1], self.full_n), float("-inf"),
+            dtype=compact.dtype, device=compact.device,
+        )
+        out[..., self.local_idx] = compact
+        return out
+
