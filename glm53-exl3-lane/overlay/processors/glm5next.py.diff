 logger = logging.get_logger(__name__)
 
+# [ours] 2026-10-30 전처리 픽셀 텐서 dtype 게이트 (VISION.md §10).
+#
+# 전처리는 rescale/normalize 를 fp32 로 계산해서 fp32 텐서를 내놓지만, 비전
+# 타워는 받는 즉시 bf16 으로 내린다(glm4_1v.py:1890 `.type(self.visual.dtype)`,
+# glm5next/nvidia/multimodal.py:567; 타워 웨이트는 이 fp8 체크포인트에서도
+# BF16 — model.py 의 quant_config=None 주석 참조).
+#
+# 그 사이 경로에는 산술이 하나도 없다: view / permute / reshape / cat 과
+# MultiModalFieldConfig.batched 의 cat·슬라이싱(glm4_1v.py:2052)뿐이고 전부
+# 비트 보존이다. 따라서 반올림을 reshape 직후로 앞당겨도 반올림은 여전히
+# fp32->bf16 한 번이고 결과는 비트 동일하다. 산술 정밀도는 fp32 로 그대로
+# 둔다 — 바꾸는 건 출력 dtype 뿐.
+#
+# ⚠️ 캐스팅 위치가 전부다. 최종 `torch.cat(...)` **뒤**에 캐스팅하면 fp32
+# 전체 사본과 bf16 전체가 동시에 살아서 피크가 오히려 커진다(실측: 41.6 ->
+# 50.7 MiB/장). 그룹 루프 안에서 reshape 직후에 내려야 fp32 사본이 cat 전에
+# 해제되고 cat 자체가 bf16 으로 일어난다(실측: 42.3 -> 21.8 MiB/장, -48%).
+#
+# 동기: 프런트엔드 전처리 피크는 이미지 장수x픽셀에 비례하고(첫 요청 뒤 GPU ViT 작업공간
+# ~1.9 GiB 는 별도 고정비), memwatch 3GB 바닥까지의 여유가 장수 상한을 결정한다(VISION.md §8, §11).
+#
+# fp16 은 일부러 넣지 않았다: fp32->fp16->bf16 은 이중 반올림이라 단일
+# 반올림과 값이 갈릴 수 있다(= 비트 동일이 아니다).
+_MM_PIXEL_DTYPES = {
+    "fp32": None,  # 업스트림 그대로
+    "float32": None,
+    "bf16": torch.bfloat16,
+    "bfloat16": torch.bfloat16,
+}
+_MM_PIXEL_DTYPE_NAME = os.environ.get("GLM53_MM_PIXEL_DTYPE", "fp32").strip().lower()
+if _MM_PIXEL_DTYPE_NAME not in _MM_PIXEL_DTYPES:
+    raise ValueError(
+        f"GLM53_MM_PIXEL_DTYPE={_MM_PIXEL_DTYPE_NAME!r} 를 모른다. "
+        f"가능한 값: {sorted(_MM_PIXEL_DTYPES)}"
+    )
+_MM_PIXEL_DTYPE = _MM_PIXEL_DTYPES[_MM_PIXEL_DTYPE_NAME]
+if _MM_PIXEL_DTYPE is not None:
+    logger.info(
+        "[ours] pixel_values dtype = %s (전처리 산술은 fp32 유지, 비트 동일)",
+        _MM_PIXEL_DTYPE_NAME,
+    )
+
+
+def _mm_patch_rows(proc, im, kwargs) -> int | None:
+    """디코드 없이 이 이미지의 패치 행 수. EXIF 회전(5~8)이면 가로세로를 바꾼다(헤더만 읽음)."""
+    if not (hasattr(im, "height") and hasattr(im, "width")):
+        return None
+    h, w = im.height, im.width
+    mark = getattr(im, "_glm53_lazy", None)
+    if mark is not None:
+        # 요청이 쥔 객체에 getexif() 를 부르면 PNG 는 전체를 디코드해 그 객체에 남긴다
+        # (PngImageFile.getexif -> load). 같은 바이트로 새 객체를 열어 보고 바로 닫는다.
+        from io import BytesIO
+        from PIL import Image as _I
+        try:
+            with _I.open(BytesIO(mark[2])) as probe:
+                if probe.getexif().get(0x0112, 1) in (5, 6, 7, 8):
+                    h, w = w, h
+        except Exception:
+            return None
+    return proc.get_number_of_image_patches(h, w, kwargs)
+
+
+def _mm_alloc_out(grouped: dict, index: dict, temporal_patch_size: int, patch_size: int):
+    """최종 pixel_values 를 미리 잡고, (그룹키, 그룹내 j) -> 원래 순서의 행 범위를 돌려준다.
+    torch.cat(reorder_images(...)) 과 같은 순서·같은 모양이다."""
+    rows_of, dim = {}, None
+    for key, st in grouped.items():
+        t = st.shape[1] if st.ndim == 5 else 1
+        t += (-t) % temporal_patch_size
+        h, w = st.shape[-2:]
+        rows_of[key] = (t // temporal_patch_size) * (h // patch_size) * (w // patch_size)
+        dim = st.shape[-3] * temporal_patch_size * patch_size * patch_size
+    where, off = {}, 0
+    for i in range(len(index)):
+        key, j = index[i]
+        where[(key, j)] = (off, off + rows_of[key])
+        off += rows_of[key]
+    return torch.empty((off, dim), dtype=_MM_PIXEL_DTYPE), where
+
+
+def _mm_pixel_cast(t: torch.Tensor) -> torch.Tensor:
+    """패치 텐서를 타워 소비 dtype 으로 미리 내린다(비트 동일). cat 전에 부를 것."""
+    if _MM_PIXEL_DTYPE is None or t.dtype == _MM_PIXEL_DTYPE:
+        return t
+    return t.to(_MM_PIXEL_DTYPE)
+
