+    def _preprocess_image_like_inputs(self, images, *args, **kwargs) -> BatchFeature:
+        """[ours] 게이트(bf16)면 한 장씩: 텐서 변환 -> 리사이즈·패치화 -> 원본 텐서 버림.
+        업스트림은 N 장을 전부 원본 크기 텐서로 바꾼 뒤에야 리사이즈해서 피크가 원본 크기 x N 이었다.
+        CPU 전처리는 그룹핑이 꺼져 있어(이미지마다 따로 계산) 한 장씩 해도 결과는 비트 동일하다."""
+        if _MM_PIXEL_DTYPE is None:
+            return super()._preprocess_image_like_inputs(images, *args, **kwargs)
+        images = self._prepare_images_structure(images, expected_ndims=3)
+        if len(images) > 0 and isinstance(images[0], (list, tuple)):
+            return super()._preprocess_image_like_inputs(images, *args, **kwargs)
+        try:  # 지연 디코드 로더(overlay/multimodal_media/image.py)가 있으면 한 장씩 마저 디코드
+            from vllm.multimodal.media.image import finish_lazy_image
+        except ImportError:
+            finish_lazy_image = None
+        out, grids, off = None, [], 0
+        for i in range(len(images)):
+            src = images[i]
+            img = finish_lazy_image(src) if finish_lazy_image is not None else src
+            t = self.process_image(img, *args, **kwargs)
+            if img is not src:
+                # 지연 이미지에서 새로 연 디코드 객체 — 우리만 쥐고 있으니 여기서 놓는다.
+                # 요청이 쥔 원래 객체(src)는 디코드된 적이 없고 닫지 않는다.
+                img.close()
+            del img, src
+            one = self._preprocess([t], *args, **kwargs)
+            del t
+            pv = one["pixel_values"]
+            if out is None:
+                rows = [_mm_patch_rows(self, im, kwargs) for im in images[i + 1:]]
+                rows = None if any(r is None for r in rows) else [pv.shape[0]] + rows
+                out = (torch.empty((sum(rows), pv.shape[1]), dtype=pv.dtype)
+                       if rows is not None else [])
+            if isinstance(out, list):
+                out.append(pv)
+            else:
+                if pv.shape[0] != rows[i]:  # 헤더로 잰 크기와 실제가 다르면 이 요청만 거절
+                    raise ValueError(f"image {i}: patch rows {pv.shape[0]} != predicted {rows[i]}")
+                out[off : off + pv.shape[0]].copy_(pv)
+                off += pv.shape[0]
+            grids.append(one["image_grid_thw"])
+            del one, pv
+        pixel_values = torch.cat(out, dim=0) if isinstance(out, list) else out
+        return BatchFeature(
+            data={"pixel_values": pixel_values, "image_grid_thw": torch.cat(grids, dim=0)},
+            tensor_type=kwargs.get("return_tensors"),
+        )
