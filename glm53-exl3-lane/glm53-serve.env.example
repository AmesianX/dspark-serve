# ============================================================================
#  GLM-5.3-Flash 2×DGX Spark 레인 설정. launch.sh(양 노드)·vllm-glm53-exl3.sh·sync-lane-67.sh 가 읽는다.
#  모든 값은 `: "${VAR:=기본}"` 형태라 명령줄 환경변수가 항상 이긴다.
#  이 파일은 양 노드에서 같아야 한다(sync-lane-67.sh 가 맞춰 준다).
# ============================================================================

# ── ① 사이트 값: 설치할 때 자기 환경에 맞게 반드시 고칠 것 ───────────────────────
: "${HEAD_RAIL_IP:=10.0.1.1}"            # 헤드의 200GbE 레일(RoCE) IP. LAN IP 아님
: "${WORKER_RAIL_IP:=10.0.1.2}"          # 워커의 레일 IP. sync-lane-67.sh 도 이 주소로 민다
: "${WORKER_SSH:=user@192.168.1.67}"     # 헤드→워커 ssh 대상(비밀번호 없이 접속돼야 함)
: "${NCCL_IF:=enp1s0f0np0}"              # 레일 인터페이스명 (ip -br a)
: "${NCCL_HCA:=mlx5_0}"                  # 레일의 RoCE HCA (ibv_devices / rdma link). 노드마다 확인
: "${NCCL_SUBNET:=10.0.1.0/24}"          # 레일 서브넷
: "${VLLM_API_KEY:?API 키를 환경변수로 지정하거나 이 줄에 직접 적을 것}"   # API 키. 새로 정할 것
: "${PORT:=8000}"

# ── ② 모델·어댑터 경로 (양 노드 같은 경로에 실파일. 심링크 금지 — 컨테이너에서 깨진다) ──
# 원본 = brandonmusic/GLM-5.3-Flash-tr3-4bpw (EXL3, routed 전문가만 4bpw·나머지 BF16).
# 검열 해제는 가중치에 굽지 않고 런타임 어댑터로 켠다(AB-SWITCH.md): abliterated 체크포인트를
# 통째로 서빙하면 "없는 것을 있다"고 하는 작화가 5배 늘었다(가짜 대상 60건 중 22 대 4).
: "${WEIGHTS_MODE:=local}"
: "${MODEL_HOST_PATH:=$HOME/Models/brandonmusic--GLM-5.3-Flash-tr3-4bpw}"
# 런타임 /ab 어댑터(29MB, tools/build_ab_lora.py). 빈 값 = 스위치 기능 전체 비활성(원본 그대로).
# 기동 시 초기 스케일은 GLM53_AB_SCALE(0=끔). 켜고 끄기는 POST /ab {"scale":0|1}.
: "${GLM53_AB_LORA:=$HOME/Models/glm53-ab-lora}"
: "${GLM53_AB_SCALE:=0}"
: "${DFLASH_DIR:=$HOME/Models/glm53-dflash2-mxfp8}"   # SPEC=dflash 일 때만 필요(기본 미사용)
: "${IMAGE:=ghcr.io/entrpi/glm-5.3-flash-exl3-2x-spark:v2.3-tier1}"

# ── ③ 검증된 운영 설정: 근거 없이 바꾸지 말 것 ────────────────────────────────
: "${MEM_USED_MAX_GB:=8}"
: "${KV_CACHE_MEMORY:=12000000000}"   # 2026-10-10: 8→12GB (847,533 → 1,186,546 토큰). 근거는 파일 끝 블록.
#                                       (이력: 2026-09-03 에 12→8GB 로 내렸던 값. 당시 근거는 "512K 1개+프리픽스
#                                        캐시 충분, 노드당 +4GB 안전망" — 병렬 서브에이전트가 없던 전제였다.)

# ── 스펙 디코딩: MTP-4 확정(09-02 k 스윕, 09-03 재확인). SPEC=dflash 는 산문에서 더 느림(29 vs 36 t/s) ──
: "${MTP:=4}"
: "${SPEC:=none}"
: "${VLLM_DFLASH_FP8_DRAFT_HEAD:=0}"   # SPEC=dflash 일 때만 의미: 포크의 rowwise-fp8 헤드 복사본이 Marlin 패킹 lm_head 와 충돌 → 0 필수

# ── dense FP8 = Marlin W8A16 (가중치만 FP8, 활성화 BF16). b12x 블록FP8(활성화 MXFP8)은 작화 유발 → 금지 ──
#  트레이드오프(09-03 실측): 디코드 +40%(산문 25.6→36.2) vs 프리필 -12%(12k 1,395→1,225 t/s; Marlin 은 큰 M 에 비효율).
#  전부 BF16 으로 되돌리려면 DENSE_FP8/LMHEAD_FP8/EH_PROJ_QUANT 를 0. 프리필 손실은 아래 BF16 이중경로가 메운다.
: "${VLLM_EXL3_DENSE_FP8:=1}"
: "${VLLM_EXL3_LMHEAD_FP8:=1}"
: "${VLLM_EXL3_DENSE_FP8_KERNEL:=marlin}"
: "${VLLM_TEST_FORCE_FP8_MARLIN:=1}"
: "${VLLM_EXL3_MTP_EH_PROJ_QUANT:=1}"   # MTP eh_proj nn.Linear(BF16 gemv) → ReplicatedLinear 로 같은 Marlin FP8 경로
: "${VLLM_EXL3_SKINNY_FP32:=1}"         # 인덱서 fp32 weights_proj 전치 레이아웃(cuBLAS 1블록 커널 90~130us → 19us, 정밀도 동일)
# 프리필 BF16 이중경로(09-03 15:40): M>1024 인 dense 호출은 Marlin FP8 을 역변환·dequant(Triton 1패스, 최대층 2.25ms)해 cuBLAS BF16.
#  디코드(M≤20)는 Marlin 그대로. 단독검증: 역변환 비트일치, M=8192 in_proj Marlin 31ms→BF16 11ms. 미달이면 PREFILL_BF16=0 으로 복귀.
: "${VLLM_EXL3_PREFILL_BF16:=1}"
: "${VLLM_EXL3_PREFILL_BF16_MIN_M:=1024}"
: "${VLLM_EXL3_INT4_DRAFT_HEAD:=0}"     # ⛔ 켜지 말 것: FP8 밑 정밀도 삭감 금지 + 실측 이득 없음(수용률 -4%). 코드만 보존

# ── b12x 커널 노브. 타일/CTA 노브(TRELLIS_TILE, M8_BLOCKS_PER_SM)는 비워 둔다(디코드 -3% 대신 프리필 -10%라 기각) ──
# 2026-09-29: dense GEMM split-K 의 부분합 누적을 bf16 atomicAdd(red.global.add.bf16x2)
# 에서 인덱스 슬롯 + 고정순서 합산으로 되돌린다. atomic 완료 순서가 실행마다 달라
# bf16(가수 8비트) 반올림이 흔들리고, 그 1e-4 차이가 KV 에 쌓여 수백 토큰 뒤 near-tie
# argmax 를 뒤집었다. 실측: MTP=1 기준 8/8 비트 동일(켜면 3~4종류로 갈림).
# 비용 없음 — 스텝 78.2 대 77.6ms(노이즈 범위), 커널에 이미 있는 결정적 경로다.
# 나머지 원인 둘은 오버레이로 고쳤다(2026-09-30): sparse 인덱스 압축의 atomic 자리선점
# (overlay/sparse_utils.py), 인덱서 top-k 의 atomic 순서·동점 선착순(overlay/
# sparse_attn_indexer_kpool.py). 셋 다 있어야 temperature 0 이 재현된다(README §4.9).
: "${B12X_DENSE_SPLITK_TURBO:=0}"
: "${B12X_EXL3_TRELLIS_TILE:=}"
: "${B12X_W4A16_M8_BLOCKS_PER_SM:=}"
# 실측 무효 판정(재론 금지): B12X_W4A16_SMALL_M_SPLITK(타일>그리드면 무효), NCCL_PROTO=LL(p50 24us 동일), INT4 드래프트 헤드.
# 상세 원장: 메모리 project_glm53_decode_kernel_truth

# mamba 상태 스냅샷 솎기 (프리픽스 캐시 생존율). 2026-09-06 추가.
#  블록 풀 중 mamba 가 큰 몫을 먹는다 (어텐션은 4608 토큰당 1블록, mamba 는 2304당 1블록).
#  vLLM 은 mamba 히트에 "경계에서 끝나는 상태 블록 단 하나" 를 요구한다. 그 하나가 재활용되면
#  어텐션 블록이 전부 살아 있어도 히트가 0 이 된다 - 부분 히트 없이 늘 0 으로 떨어지던 이유.
#  실측: 99.1% -> 0.0%, 12만 토큰 재프리필에 약 123 초.
#  retention 은 mamba/sliding-window 만 솎고 full-attention 은 dense 를 유지한다.
#  값은 scheduler_block_size(lcm(2304,4608)=4608) 의 배수여야 하고, 아니면 기동을 거부한다.
#    9216 = 4608 x 2 -> mamba 스냅샷 1/4.   18432 = 4608 x 4 -> 1/8.
#  블록 비용(소스 확인, single_type_kv_cache_manager.reachable_block_mask):
#    대화 L 토큰 = attention L/4608 블록 + mamba 체크포인트 L/retention 블록. 풀은 215블록.
#    실행 중 mamba 상태는 누적되지 않는다. mamba_cache_mode="align" 에서 직전 블록은
#    현재 블록으로 복사된 뒤 즉시 해제된다(remove_skipped_blocks). 길이에 비례하는 건
#    캐시로 남길 체크포인트뿐이고, retention 이 솎는 대상도 그것뿐이다.
#    full-attention 은 retention 을 무시하고 항상 dense 다.
#
#  2026-09-13 실측 (retention=18432, 부모를 441,165 토큰으로 고정한 뒤 별개 대화 S 를
#  프리필하고 부모를 재요청해 프리픽스 적중률을 읽음):
#    S <= 270,000  부모 무손상. 270,000 은 10/10, 그 아래는 8종 9회 전부.
#    S  = 280,000  부모가 attention 블록 1개를 내준다. 10회 모두. 재계산 약 8초.
#    S  = 290,000  1회 유지, 2회 전멸(0.0%, 25.1%). 경계는 확률적이다.
#    S >= 296,945  부모 0.0% 전멸. 약 360초 전체 재프리필.
#  클라이언트 설정은 이 한도를 ceiling 과 출력이 나눠 쓴다:
#    subagent_context_ceiling_tokens 230,000 + subagent_max_tokens 32,768
#    = 262,768 < 270,000.
#  경계는 임계선이 아니라 확률적이다. 같은 290,000 이 살았다 죽었다 한다.
#  실패는 점진적이지 않다. mamba 히트는 경계에서 끝나는 상태 블록 하나를 요구하므로
#  체크포인트 하나만 잃어도 적중이 0 이 된다. 그래서 절벽에 붙이지 말 것.
#
#  주의: "GPU KV cache size: N tokens" 로그로 계산하지 말 것. 그 N 은
#  int(max_concurrency * max_model_len) 이고 max_concurrency 는
#  풀블록수 / 최대길이요청1개의블록수 다. 한 요청의 최악치를 말할 뿐,
#  캐시에 동시에 앉을 수 있는 대화량이 아니다. 이 둘을 혼동해서 나온 값들이
#  이 주석이 대체한 135k / 280k / 375k 였다.
#
#  아직 안 잰 것: 9216 에서의 같은 실측. 위 수치는 전부 18432 에서만 나온 것이므로
#  "18432 로 올려서 좋아졌다" 는 주장은 아직 근거가 없다. 되돌릴지 판단하려면
#  9216 에서 같은 스윕을 다시 돌려야 한다.
#  되돌리기: 아래 한 줄을 9216 으로 되돌리거나 주석 처리 (미설정 = dense = 종전 동작).
: "${VLLM_PREFIX_CACHE_RETENTION_INTERVAL:=18432}"

# ── 드래프트 전용 축소 어휘 (09-27, exp/step70) ─────────────────────────────
# MTP 드래프트 argmax 만 32,768 토큰 서브셋 FP8 lm_head 로. verify 는 전체 어휘 → 출력 무손실, 수용률만 영향.
# 스텝 -3ms · t/s +3~5% (README §5). 빈 값=끔(전체 어휘 드래프트).
: "${VLLM_GLM53_DRAFT_VOCAB:=/lane/draft_vocab_32k.json}"
# 기각(코드는 git 이력에만): 라우터 ll_bf16 dotprod(VLLM_SM12X_LL_ROUTER), verify top-p Triton(VLLM_TOPKP_TRITON_MIN_ROWS).
# ── routed-expert SwiGLU clamp (09-27) ─────────────────────────────────────────
# GLM-5.3 swiglu_limit=10 이 EXL3 MoE 경로(b12x fused Trellis / mixed / exllamav3 / torch)에 전달되지 않던
# 상류(Entrpi) 누락 — 이상치 토큰에서 routed 전문가 출력이 레퍼런스보다 커진다. 실사용 b12x 경로는 중간값이
# BF16/FP32 라 오버플로는 아님(fp16 중간값은 미사용 exllamav3 경로만). 0=상류 동작.
# ('!' 연타 붕괴의 진짜 원인은 별개였다 — 프리필 꼬리 5토큰이 디코드 그래프로 재생되던 버그, overlay/v2runner/, HISTORY 10-02)
: "${VLLM_EXL3_MOE_SWIGLU_CLAMP:=1}"

# ── 병렬 서브에이전트 세대(2026-10-10) ───────────────────────────────────────
#  KV 8→12GB: 847,533 → 1,186,546 토큰(512K 1.62x → 2.26x). 400K 콜드 프리필
#  전 구간 MemAvailable 하한 헤드 5.90 / 워커 8.85 GiB (memwatch 선 3GiB).
#  13.4e9 은 하한 2.26GiB 로 무너졌던 값이므로 12e9 가 상한에 가깝다.
#  실측: 400K 부모 + 서브에이전트 3개 동시(각 133K) 후 부모 캐시적중 98.9% 유지.
#  MAX_SEQS 4 유지: 슬롯 풀(codemason max_concurrent_subagents=3)이 먼저 막으므로
#  서브 3 + 여유 1 로 충분하다. 8 은 외부 클라이언트가 긴 프롬프트를 여러 개
#  던질 때 KV 초과 수용 위험만 남긴다.
#  혼합 프리필 게이트: CAP 은 블록 그리드(4608) 이상이어야 한다 — 레인 주석의
#  권장값 512 는 이 모델에서 kpool 인덱서가 거부하고 헤드가 ExitCode=1 로 죽는다.
#  겹침 시 디코드 ITL 중앙 1,952ms → 78ms. 단독 프리필은 영향 없음(121K/220K/321K
#  전후 1,225/1,257/1,222 vs 1,241/1,272/1,236 t/s).
: "${MIXED_PREFILL_CAP:=4608}"
: "${MIXED_PREFILL_DECODE_WEIGHT:=1.0}"
#  [exp/prefill-fair-4608] 스텝 예산을 2304 격자에 맞추고(9216+디코드·draft 20)
#  프리필 청크를 4608 로 묶어 A 의 긴 프리필 중에도 B 의 새 턴이 같은 스텝에 들어가게 한다.
: "${MNBT:=9236}"
: "${LONG_PREFILL:=4608}"
#  [exp/glm53-vision] 이미지 입력 수용. 이 브랜치의 실험 기본값이다.
#  인코더 예산은 max(MNBT, 아이템토큰) 이라 아이템이 MNBT=9236 을 넘으면 ViT
#  활성화가 같은 배수로 커진다 — 비디오(32,242 토큰/아이템)는 limit 0 으로 닫고,
#  이미지는 VISION_MAX_TOKENS 로 MNBT 밑에 고정한다. 근거·산식은 VISION.md.
#  ⚠️ 반드시 env 에 둘 것: vllm-glm53-exl3.sh 의 start_worker 는 평범한 ssh 라서
#  셸 환경변수가 워커로 넘어가지 않는다(한쪽만 비전 = 랭크 불일치로 기동 실패).
: "${VISION:=1}"
: "${VISION_MAX_TOKENS:=4096}"   # 한 장 상한(캔버스 1792x1792). 체크포인트 기본
#                              8000(=7,921 토큰)은 MNBT 9,236 과 여유 14% 뿐이라 명시 고정.
#                              ⛔ 이 값을 올리는 것만이 위험하다(인코더 예산을 들어올림).
: "${VISION_MAX_IMAGES:=5}"    # ⚠️ 2026-11-01 8 -> 5. 유저 실사용 상한(보통 1장, 많아야 2장,
#                              심각할 때 4~5장)에 맞춘다. 장수별 실측(clean n=2, 1792²):
#                              1장 낙폭 0.00GB·창 0.0s / 2장 0.44GB·26.2s / 5장 0.78GB·37.3s /
#                              8장 1.02GB·31.3s. 여유는 기준선 5.3~6.0 - 바 3.0 = 2.3~3.0GB 라
#                              8장 동시 3개(3.06GB)는 memwatch 가 서빙을 내리고 5장은 2.34GB 로 들어온다.
#                              초과 요청은 디코드 전에 400. ⚠️ 2026-10-30 128 -> 8. 이전 주석의 "장수는 메모리
#                              안전"은 틀렸다 — GPU 인코더 예산은 정말 불변이지만(그건
#                              맞다), 장수에 비례하는 건 헤드의 '호스트' 전처리 피크다.
#                              전처리는 N 장을 한 텐서로 만든다(glm5next.py 의
#                              torch.cat(processed_images)), 그 피크가 상한을 정한다.
#
#  ⛔ 2026-10-30 정정: 여기 있던 "가용 예산 0.97 GiB = 32,768 토큰 → 8장@1792² ✅", "같은 합계면
#  피크가 같다", "KV 축소로 예산 키우기"는 틀렸다(896² 수치를 1792² 로 옮긴 것 / 오프라인에서만
#  확인 / 금지된 레버). 라이브 실측(헤드 MemAvailable 최저, 웜, 8장@1792²):
#    세션1 3.63/3.70 (바 위 +0.63/+0.70), 세션2 3.26~3.38 (+0.26~0.38) — 요구 갭 1.0~1.5 미달.
#  첫 이미지 뒤 헤드에 ~3.3 GiB 가 묶인다(GPU ViT 작업공간 1.9 + API 서버 1.0 + EngineCore 0.3).
#  상세·표 = VISION.md §8, §11.
#
#  구조 상한은 별개로 max_model_len // 아이템토큰 = 128 이다(컨텍스트 축). 메모리 상한이 아니다.
# 지연 디코드 + 한 장씩 전처리(비트 동일). 피크는 장수와 무관, 가장 큰 한 장 크기에 비례. VISION.md §12
: "${VISION_LAZY_DECODE:=1}"
# 원본 한 장 픽셀 상한 = 4K UHD 3840x2160. 그보다 큰 것은 400 — 큰 원본은 codemason 이 보내기 전에
#  줄인다(서버가 다 처리할 필요 없음, 유저 결정 10-30). VISION.md §14
: "${VISION_MAX_IMAGE_PIXELS:=8294400}"
