# Solar Open 2 레인 설정. launch.sh 가 읽는다. 명령줄 환경변수가 이긴다(: ${VAR:=} 관용구).
: "${HEAD_RAIL_IP:=10.0.1.1}"
: "${WORKER_RAIL_IP:=10.0.1.2}"
: "${NCCL_IF:=enp1s0f0np0}"
: "${NCCL_HCA:=mlx5_0}"
: "${NCCL_SUBNET:=10.0.1.0/24}"
: "${MODEL_HOST_PATH:=/home/user/Models/nota-ai--Solar-Open2-250B-Nota-NVFP4}"
: "${IMAGE:=vllm/vllm-openai:v0.22.0-aarch64}"
: "${PORT:=8000}"
: "${VLLM_API_KEY:?API 키를 환경변수로 지정하세요}"
: "${MAX_LEN:=524288}"
: "${MAX_SEQS:=4}"
: "${GMU:=0.85}"
# NVFP4→Marlin repack 파편 회수(끄면 기동 중 OOM). 상세 계측은 SOLAR_MEM_PROBE=1.
: "${SOLAR_MEM_RECLAIM:=1}"
: "${SOLAR_MEM_PROBE:=0}"
# 첫 요청에서 Triton/FlashInfer 커널 JIT 가 길다. 기본 300초는 엔진 자폭을 부른다.
: "${EXEC_TIMEOUT_S:=1800}"
# KV 명시 상한(설정 시 GMU 무시). 통합메모리라 vLLM 의 GPU 예산이 곧 호스트 RAM이고,
# 0.85 자동산정은 추론 중 가용 9.6GB만 남겨 OOM 을 냈다(2026-09-24 실측).
# 20GiB ≈ 74만 토큰. 헤드룸 ~20GB 확보.
: "${KV_BYTES:=21474836480}"
