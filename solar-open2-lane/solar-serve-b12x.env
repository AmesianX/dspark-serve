# ── b12x A/B 변종 ────────────────────────────────────────────────
#  MoE: CLI 로 명시 옵트인 (oracle/nvfp4.py:148 매핑, 자동선택에서만 제외됨)
: "${MOE_BACKEND:=flashinfer_b12x}"
#  선형: --linear-backend 에는 b12x 선택지가 없다(2026-09-24 확인).
#        kernels/linear/__init__.py:821 의 "flashinfer-b12x" 는 이 환경변수로만 열린다.
: "${NVFP4_GEMM:=flashinfer-b12x}"
: "${LINEAR_BACKEND:=marlin}"
