[Unit]
Description=DSpark encrypt gateway (uvicorn :8443, AES body-decrypt in front of vLLM)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/work/dspark-serve
# One definition of the environment: run-gateway.sh exports LLAMACPP_AES_KEY and
# VLLM_UPSTREAM and sources VLLM_API_KEY out of the lane env file, so the secrets
# are not pasted here as well. `fg` execs uvicorn in the foreground, which is what
# Type=simple wants.
ExecStart=/home/user/work/dspark-serve/run-gateway.sh fg
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
